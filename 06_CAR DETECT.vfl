// ════════════════════════════════════════════════════
// CAR DETECT: 前方の最近傍車両（同レーン先行車 + 交差/右左折車）
// 書く: i@car_ptnum, f@dist_to_car, f@car_vel, i@car_signal, i@car_is_cross
// ════════════════════════════════════════════════════
i@car_ptnum    = -1;
f@dist_to_car  = 9999.0;
f@car_vel      = 0.0;
i@car_signal   = -1;
i@car_is_cross = 0;

float same_dot     = 0.6;   // 同レーン先行車のコーン

int pts[] = nearpoints(0, @P, @search_radius);

foreach(int pt; pts) {
    if (pt == @ptnum) continue;
    if (point(0, "car", pt) != 1) continue;

    vector to_other = point(0, "P", pt) - @P;
    float  d = length(to_other);
    if (d < 1e-4) continue;
    float fwd_dot = dot(to_other / d, v@dir);

    int same_lane = (point(0, "lane_name", pt) == s@lane_name);
    int is_cross  = 0;

    if (same_lane) {
        if (fwd_dot < same_dot) continue; //前方の車だけを処理
    } else {
        // ★ 角度の円錐＋横幅の幾何近似（誤検出/見逃しの原因）をやめ、道路トポロジーで
        //   確定済みのcross_curves（lane_name配列、03_UPDATE_LANE_ATTRIB.vflでlane_changed
        //   時にキャッシュ済み）に相手のlane_nameが含まれるかで判定する。
        //   ★ cross_linesは見ない：右折車→直進車の交錯は07_RESOLVE_CONFLICT(M2)が
        //   TTC込みで専任しているので、ここでも拾うとdist_to_car/yield_conflictの
        //   二重管理になる（M3の役割分担：直進車→右折車の検知だけをここが担当）。
        //   右折車のcross_curvesは常に空配列なので、この判定は右折車には一切ヒットしない。

        //
        if (fwd_dot < 0.0) continue;   // 自分より後方の相手は無視
        string other_lane_name = point(0, "lane_name", pt);
        if (find(s[]@cross_curves, other_lane_name) < 0) continue;
        // ★ 相手（右折車）が既にyield確定済みなら、自分に道を譲って止まってくれる
        //   ので前方車として扱わない（この判定は06→07の実行順により1フレーム遅れる。
        //   実用上は無視できる程度のはず）。
        if (point(0, "yield_conflict", pt) == 1) continue;
        is_cross = 1;
    }

    if (d < f@dist_to_car) {
        f@dist_to_car  = d;
        i@car_ptnum    = pt;
        i@car_is_cross = is_cross;

        // IDM用: 自車進行方向へ射影した前方速度
        float  v_other   = point(0, "vel", pt);
        vector dir_other = point(0, "dir", pt);
        f@car_vel = is_cross
                  ? max(v_other * dot(dir_other, v@dir), 0.0)
                  : v_other;

        int front_state = point(0, "car_state", pt);
        i@car_signal = (front_state == 1 || front_state == 2) ? 1 : 0;
    }
}