// ════════════════════════════════════════════════════
// CAR DETECT: 前方の最近傍車両（同レーン先行車 + 交差/右左折車）
// 書く: i@car_ptnum, f@dist_to_car, f@car_vel, i@car_signal, i@car_is_cross, i@car_stalled
// ════════════════════════════════════════════════════
i@car_ptnum    = -1;
f@dist_to_car  = 9999.0;
f@car_vel      = 0.0;
i@car_signal   = -1;
i@car_is_cross = 0;
i@car_stalled  = 0;   // デバッグ用：選ばれた前車がレーン非依存のフォールバック由来なら1

float same_dot     = 0.6;   // 同レーン先行車のコーン
float cross_dot    = 0.3;   // 交差車のコーン（1車線横なら1.1m以上前にいる相手だけ拾う）
// 交差道路から入る車は、交差点内に残った右折車をどの経路でも拾えない。
// レーンに関係なく、速度・距離・横ズレの3つだけで障害物として拾う
float stalled_vel      = 0.5;    // m/s（これ未満を取り残されているとみなす）
float stalled_range    = 15.0;   // m（遠いほどコーンが隣の車線に届くので近距離限定）
float stalled_dot      = 0.9;    // 正面に近いものだけ
float stalled_corridor = 1.5;    // m（横方向の許容＝半車線）

// 右折中＝コネクタ上（turn=="right"）か、1つ手前のレーンで先読み中（rt_lookahead）
int turning_right = (s@turn == "right" || i@rt_lookahead == 1);

int pts[] = nearpoints(0, @P, @search_radius*1.1);

foreach(int pt; pts) {
    if (pt == @ptnum) continue;
    if (point(0, "car", pt) != 1) continue;

    vector opp_p    = point(0, "P", pt);   // 型を明示して受ける（多重定義回避）
    vector to_other = opp_p - @P;
    float  d = length(to_other);
    if (d < 1e-4) continue;
    float fwd_dot = dot(to_other / d, v@dir);

    string other_lane_name = point(0, "lane_name", pt);
    // 交差点に入った前車はコネクタ＝行き先レーンのlane_nameに変わる一方、後続車は
    // 手前まで来ないと切り替わらない。next_lane_nameも同一レーン扱いにしないと、
    // 交差点で止まっている前車を見失う
    // ★ 自分がその行き先へ行かない場合（前車だけ右折）はnext_lane_nameでも一致しないので、
    //   past_lane（02が退避した直前のlane_name）で自分のレーンから出ていった前車も拾う
    string other_past = point(0, "past_lane", pt);   // 空同士で一致させない
    int same_lane = (other_lane_name == s@lane_name)
                 || (other_lane_name == s@next_lane_name)
                 || (other_past != "" && other_past == s@lane_name);
    int is_cross   = 0;
    int is_stalled = 0;

    if (same_lane) {
        if (fwd_dot < same_dot) continue; //前方の車だけを処理
    } else {
        if (fwd_dot < cross_dot) continue;   // 自分より後方・真横の相手は無視
        // ★ 相手（右折車）が既にyield確定済みなら、自分に道を譲って止まってくれる。
        //   下のフォールバックもこの除外を通る（譲っている車を障害物扱いすると互いに待ち合う）
        if (point(0, "yield_conflict", pt) == 1) continue;

        // ★ 右折中は左折車を進路が交わる相手として扱わない（07の候補除外と同じ扱い）。
        //   コネクタ上の左折車と、手前の直進レーンで左折待ちの車の2経路で拾う。
        //   同じ出口レーンへ合流してくる左折車は上のsame_laneで前車として拾う
        if (turning_right) {
            string other_turn = point(0, "turn",      pt);
            string other_next = point(0, "next_turn", pt);
            if (other_turn == "left") continue;
            // 直進レーンの点はturnが既定値("")のことがある。010と同じく""も直進扱い
            if ((other_turn == "straight" || other_turn == "") && other_next == "left") continue;
        }

        // 右折車のみしか、cross_curvesは持たないから、直進車しかここでは処理されない
        int cross_idx = find(s[]@cross_curves, other_lane_name);
        if (cross_idx >= 0) {
            // ★ この相手との交錯点を自分が既に通過していたら無視する。
            //   fwd_dot >= 0 は180度の半空間なので、真横にいる右折車まで拾ってしまう。
            //   交錯点座標はcross_curvesと同indexで14_BAKE_CROSS_CURVES.vflがベイク済み
            vector cross_ps[] = v[]@cross_curve_pos;
            if (cross_idx < len(cross_ps)) {
                vector cp     = cross_ps[cross_idx];
                vector to_cp  = cp - @P;
                float  len_cp = length(to_cp);
                if (len_cp > 1e-4 && dot(normalize(v@dir), to_cp / len_cp) <= 0) continue;

                // ★ 信号の停止線が交錯点より手前なら、その相手は交錯点まで来ない。
                //   ctrl_src==0は08が「最も近い停止目標＝信号」と決めた車（黄の通過コミット中は car_state==0）
                if (point(0, "car_state", pt) != 0 && point(0, "ctrl_src", pt) == 0
                 && point(0, "dist_to_signal", pt) < distance(cp, opp_p)) continue;
            }
            is_cross = 1;
        } else {
            // ★ レーン非依存のフォールバック。止まっていることを必須にするので、
            //   走行中の他レーンの車（対向直進・隣車線）は拾わない
            if (point(0, "vel", pt) >= stalled_vel) continue;
            if (d > stalled_range)                  continue;
            if (fwd_dot < stalled_dot)              continue;
            float lat = length(to_other - (fwd_dot * d) * normalize(v@dir));
            if (lat > stalled_corridor)             continue;
            // is_cross扱い：09は静止障害物向けのs0/Tを使い、07のlead_headwayからも外れる
            is_cross   = 1;
            is_stalled = 1;
        }
    }

    if (d < f@dist_to_car) {
        f@dist_to_car  = d;
        i@car_ptnum    = pt;
        i@car_is_cross = is_cross;
        i@car_stalled  = is_stalled;

        // IDM用: 自車進行方向へ射影した前方速度
        float  v_other   = point(0, "vel", pt);
        vector dir_other = point(0, "dir", pt);
        f@car_vel = is_cross
                  ? max(v_other * dot(dir_other, v@dir), 0.0)
                  : v_other;
                  
        // 前方の車の状態に合わせる
        int front_state = point(0, "car_state", pt);
        i@car_signal = (front_state == 1 || front_state == 2) ? 1 : 0;
    }
}