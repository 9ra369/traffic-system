f@dist_to_target = 9999.0;
int ctrl_state = 0;
i@ctrl_src     = -1;
// デバッグ用：前車に追従(IDM)するか自分で判断するかを、どの条件で決めたか
//  -1 前車がいない（i@car_ptnum < 0）
//   0 前車を見捨てて自分で判断（follow_ok=0。後続右折車で期待する値）
//   1 follow_okだが停止対象の方が近い → 自分で判断
//   2 yield_conflict==0 なので前車に追従
//   3 前車が減速/停止中（car_signal==1）なので前車に追従
//   4 前車の実速度が leader_slow 未満なので前車に追従
//   5 停止対象まで余裕がない → 前車が近くても自分で止まる
i@dbg_follow       = -1;
f@dbg_nearest_stop = 9999.0;   // dist_to_carと比較している停止対象までの距離
f@dbg_stop_need    = 0.0;      // その停止対象に対して、今から止まるのに要る距離

// ── 急に現れた歩行者で止まり切れないなら、通過する（07の交錯点と同じ考え方） ──
// 横断帯の上で急停止する方が危険で、歩行者が自車レーンに達するまでには時間がある。
// ★ 判定は巡航中(car_state==0)だけ。減速開始後に切り替えると加減速を往復する
int ped_pass = 0;
if (i@ped_crossing == 1 && i@car_state == 0) {
    float ped_offset  = 2.0;                   // 下のstop_offset(ctrl_src==2)と揃える
    float brake_decel = f@max_decel * 3.0;     // 緊急制動。07のemerg_decel_ratioと同値
    float stop_dist   = (f@vel * f@vel) / (2.0 * max(brake_decel, 0.01));
    ped_pass = (stop_dist > f@dist_to_ped - ped_offset);
}
i@dbg_ped_pass = ped_pass;   // デバッグ用：通過を選んだら1

// 前車がいる場合、信号・歩行者・コンフリクトより遠ければIDMに任せる
if (i@car_ptnum >= 0) {
    float nearest_stop = 9999.0;
    if ((i@signal_state == 1 || i@signal_state == 2))
        nearest_stop = min(nearest_stop, f@dist_to_signal);
    if (i@ped_crossing == 1 && !ped_pass)
        nearest_stop = min(nearest_stop, f@dist_to_ped);
    if (i@yield_conflict == 1)
        nearest_stop = min(nearest_stop, f@dist_to_conflict);

    // ★ yield中は「前車の方が近い」だけでIDMに預けてはいけない。交錯点は前車より
    //   遠いのが普通なので、先行右折車が先に抜けると後続車は譲る判断を持ったまま
    //   追走して突っ込む。前車が減速/停止しているときだけ前車を実質の停止線とみなす
    float leader_slow = 1.0;   // m/s
    int   follow_ok   = 1;
    int   follow_why  = 0;
    if      (i@yield_conflict == 0)    follow_why = 2;
    else if (i@car_signal == 1)        follow_why = 3;
    else if (f@car_vel < leader_slow)  follow_why = 4;
    else                               follow_ok  = 0;

    // ★ 停止対象が「今から止まれる距離」を切ったら、前車が近くてもIDMに預けない。
    //   前車が横断歩道を抜けて初めて減速を始めると、残距離が足りず踏み越える
    float brake_ref = f@max_decel * 2.0;   // 09が実際に出す減速度の目安
    float stop_need = (f@vel * f@vel) / (2.0 * brake_ref) + f@vel * 0.5 + 1.0;
    int   can_defer = (nearest_stop > stop_need);

    f@dbg_nearest_stop = nearest_stop;
    f@dbg_stop_need    = stop_need;

    if (follow_ok && can_defer && f@dist_to_car <= nearest_stop) {
        // 前車の方が近い → IDMに任せる
        i@dbg_follow    = follow_why;
        i@car_state     = 0;
        i@yellow_commit = 0;
        i@yellow_judged = 0;
        return;
    }
    i@dbg_follow = !follow_ok ? 0 : (can_defer ? 1 : 5);
    // 信号・歩行者・コンフリクトの方が近い（or 抜けていく前車） → 以降の判定に進む
}

if ((i@signal_state == 1 || i@signal_state == 2)
        && f@dist_to_signal < f@dist_to_target) {
    f@dist_to_target = f@dist_to_signal;
    ctrl_state = i@signal_state;
    i@ctrl_src = 0;
}
if (i@ped_crossing == 1 && !ped_pass && f@dist_to_ped < f@dist_to_target) {
    f@dist_to_target = f@dist_to_ped;
    ctrl_state = 2;
    i@ctrl_src = 2;
}
// M4: 右折コンフリクト（07_RESOLVE_CONFLICTのyield判定）。赤信号・歩行者と同じ
// 「止まって待つ」(ctrl_state=2)として同列に比較する。減速度計算は他と共通の
// required_decel式にそのまま乗せる（専用のブレーキ設定は持たない）。
if (i@yield_conflict == 1 && f@dist_to_conflict < f@dist_to_target) {
    f@dist_to_target = f@dist_to_conflict;
    ctrl_state = 2;
    i@ctrl_src = 3;
}
// ── 黄色通過コミット中 ──────────────────────────────
if (i@yellow_commit == 1 && i@ctrl_src == 0) {
    i@car_state = 0;
    if (i@signal_state == -1) { i@yellow_commit = 0; i@yellow_judged = 0; }
    return;
}
// ── 状態遷移 ────────────────────────────────────────
if (ctrl_state == 2) {
    i@yellow_commit = 0;  i@yellow_judged = 0;
    if (i@car_state == 0) {
        i@car_state = 1;
        // 横断歩道(ctrl_src=2)は点が横断帯の中央にあるので、車体が帯に入らないよう厚く取る
        float stop_offset = (i@ctrl_src == 2) ? 2.0 : 1.0;
        f@effective_dist  = f@dist_to_target - stop_offset;
        f@required_decel  = (f@vel * f@vel) / (2.0 * max(f@effective_dist, 0.01));
    }
    if (f@vel <= 0.05) i@car_state = 2;
} else if (ctrl_state == 1) {
    if (i@yellow_judged == 0) {
        i@yellow_judged = 1;
        float stop_offset = 1;
        f@effective_dist  = f@dist_to_signal - stop_offset;
        float possible_dist = f@vel * f@yellow_remain - 6;
        if (possible_dist >= f@dist_to_signal) {
            i@car_state = 0;  i@yellow_commit = 1;
        } else {
            i@car_state = 1;  i@yellow_commit = 0;
            f@required_decel = (f@vel * f@vel) / (2.0 * max(f@effective_dist, 0.01));
        }
    }
} else {
    i@yellow_commit = 0;  i@yellow_judged = 0;
    if (i@car_state == 1 || i@car_state == 2) i@car_state = 0;
}