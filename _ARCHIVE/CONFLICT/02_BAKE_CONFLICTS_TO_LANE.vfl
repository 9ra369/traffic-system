// ════════════════════════════════════════════════════
// BAKE CONFLICTS TO LANE (SOP, Run Over: Primitives)
// Input 0: レーン prim（直線 + コネクタ）← ここに書き込む
// Input 1: CONFLICT POINT ATTRIB 済みの交点
// 書く: i[]@cross_lanes, v[]@cross_pos（同一 index で 1:1 対応）
// ════════════════════════════════════════════════════
int    my_lane = @lane_id;
int    cf_lane[];
vector cf_pos[];

for (int i = 0; i < npoints(1); i++) {
    int cand[] = point(1, "candidate", i);
    if (len(cand) < 2) continue;

    int laneA = cand[0];
    int laneB = cand[1];
    int prevA = point(1, "prev_a", i);
    int prevB = point(1, "prev_b", i);

    // 自分のレーン、または自分が手前レーンとして登録されているか
    int is_a = (my_lane == laneA || my_lane == prevA);
    int is_b = (my_lane == laneB || my_lane == prevB);
    if (is_a == is_b) continue;   // 無関係(両方0) or 異常(両方1)

    append(cf_lane, is_a ? laneB : laneA);
    append(cf_pos,  point(1, "P", i));
}

// 重複排除はしない。同じ相手レーンと2回交わる形状があり得るため全ペアを保持する。
// 「前方の最寄り」の選択はランタイム側（CONFLICT DETECT）の責務。
i[]@cross_lanes = cf_lane;
v[]@cross_pos   = cf_pos;
