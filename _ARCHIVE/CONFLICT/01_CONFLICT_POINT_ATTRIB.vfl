// ════════════════════════════════════════════════════
// CONFLICT POINT ATTRIB (SOP, Run Over: Points)
// Input 1 / Input 2: カーブA / カーブB (lane_id, prev_lane を持つ)
// 書く: i[]@candidate, i@prev_a, i@prev_b, s@road_a/s@road_b(debug)
// ════════════════════════════════════════════════════
int sprim[] = i[]@sourceprim;
int laneA = prim(1, "lane_id", sprim[0]);
int laneB = prim(2, "lane_id", sprim[1]);

// 同じ出口に向かう＝合流。交差ではないので捨てる
if (laneA == laneB) { removepoint(0, @ptnum); return; }

i[]@candidate = array(laneA, laneB);

// 手前レーン（先読み用）。int のまま持つ
i@prev_a = prim(1, "prev_lane", sprim[0]);
i@prev_b = prim(2, "prev_lane", sprim[1]);

// デバッグ表示用（ランタイムでは使わない）
s@road_a = "road_" + itoa(laneA);
s@road_b = "road_" + itoa(laneB);
