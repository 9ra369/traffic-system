// ════════════════════════════════════════════════════
// CONFLICT POINT ATTRIB: 交点に交わる2レーンを焼く
// Input 1 / Input 2: カーブA / カーブB (lane_id, prev_lane)
// ════════════════════════════════════════════════════
int sprim[] = i[]@sourceprim;
int laneA = prim(1, "lane_id", sprim[0]);   // 直線スプライン
int laneB = prim(2, "lane_id", sprim[1]);   // 曲線スプライン

// 同じ出口に向かう＝合流。交差ではないので捨てる
if (laneA == laneB) { removepoint(0, @ptnum); return; }

// 交わるコネクタ自身の名前
s@road_a = "road_" + itoa(laneA);
s@road_b = "road_" + itoa(laneB);

// そのコネクタに入る手前のレーン（車が減速を始められるように）
s@from_a = "road_" + itoa(prim(1, "prev_lane", sprim[0]));
s@from_b = "road_" + itoa(prim(2, "prev_lane", sprim[1]));

i[]@candidate = array(laneA, laneB);