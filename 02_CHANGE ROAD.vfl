// xyzdistを使って、自分と同じroad nameを持っているスプラインを見つけ
// その中におけるパラメトリック座標で、末端に近づいたら、次のスプラインへ

int hitprim;
vector uvw;
float d = xyzdist(1, s@lane_name, @P, hitprim, uvw);
i@lane_prim = hitprim;   // 010の横方向補正が寄せる先。見つからなければ-1が入る

if (hitprim >= 0) {          // 見つかったか確認
    @u = uvw.x;
    // 行き止まりレーンか(15_BAKE_LANE_END.vflで判定済み)。削除は013_KILL_POINTSが行う
    i@lane_dead_end = prim(1, "end", hitprim);
    if (i@lane_dead_end != 1 && uvw.x >= 0.99 && s@next_lane_name != "") {
        // next_lane_nameが空のまま切り替えると、03のnearpointが解決できず
        // lane_changedが1で固着し、passed/cross_lines等が前のレーンの値のまま残る。
        // endが0なのにここで止まる車がいたら、next_lanesの引き当て失敗を疑う
        s@past_lane = s@lane_name;   // 上書き前に退避。06が「自分のレーンから出ていった前車」を拾うのに使う
        s@lane_name = s@next_lane_name;
        i@lane_changed = 1;
    }
}