// ════════════════════════════════════════════════════
// RESOLVE_CONFLICT: 右折 vs 直進 コンフリクト解決（M1・M2・M4・M5-1・M6実装済み）
// 旧 07_CONFLICT_DETECT / CONFLICTフォルダ一式 を置き換える（_ARCHIVE へ移動済み）。
// 設計・進捗は RESOLVE_CONFLICT/00_OVERVIEW.md 以下のマイルストーンMDを参照。
//
// Input 0: 車両
// 読む: s@turn, v@dir, v@cross_pos, i@passed（直進車、M1でキャッシュ済み）
//      s[]@cross_lines, v[]@rt_target_cp（右折車、03_UPDATE_LANE_ATTRIB.vflで
//        lane_changed時にキャッシュ済み。rt_target_cpはRoad Line側のcross_pos(prim)
//        由来で、追跡中の相手車個体には依存しない。M6b）
// 書く: i@passed, i@passed_frame_count（直進車）
//      i[]@rt_decided, i[]@rt_target_id, i[]@rt_target_lock, v[]@rt_target_cp
//        （右折車、内部状態。cross_linesと同じindexで1本ずつ独立に持つ。M5-1）
//      i@yield_conflict, f@dist_to_conflict（右折車、全indexを集約した値。M4が読む）
// ════════════════════════════════════════════════════

// 等加速度運動で距離distに到達するまでの時間（t_other/t_ego共通）。
// a≈0は等速の式に退化、判別式が負なら手前で止まり到達しない、解が負なら等速へフォールバック。
float time_to_reach(float dist; float vel; float accel; float v_floor) {
    if (abs(accel) < 1e-4) return dist / max(vel, v_floor);
    float disc = vel * vel + 2.0 * accel * dist;
    if (disc < 0) return 9999.0;
    float t = (-vel + sqrt(disc)) / accel;
    return (t <= 0) ? dist / max(vel, v_floor) : t;
}

//   cross_pos/passedのリセット・再取得は lane_changed の瞬間に行う
//   （03_UPDATE_LANE_ATTRIB.vfl の lane_changed ブロックに実装済み）。

//直進車と交錯点の位置関係の判断
if (s@turn == "straight" && i@passed == 0) {
    vector to_cross = v@cross_pos - @P;
    float  d = dot(normalize(v@dir), normalize(to_cross));

    if (d <= 0) {
        // 交錯点はもう後方 → 通過。48フレーム連続で確認できたら確定する
        i@passed_frame_count += 1;
        if (i@passed_frame_count >= 48) {
            i@passed             = 1;
            i@passed_frame_count = 0;   // 確定したのでカウントは掃除しておく
        }
    } else {
        i@passed_frame_count = 0;       // まだ前方 → カウントは貯めない
    }
}
// passed==1の直進車は、右折車側の検索(M2)から除外する。

// M2: 右折車(turn=="right")側 — 交錯する直進車の検索・判断
//   詳細・パラメータの根拠は RESOLVE_CONFLICT/M2_right_turn_search.md 参照。
//   M5-1: cross_linesが複数のlane_nameを持つ場合（1本の右折曲線が複数の直進レーンと
//   交錯する）に対応するため、判断ラッチ(rt_decided/rt_target_id/rt_target_lock/
//   rt_target_cp)はcross_linesと同じindexの配列にしてあり、相手レーンごとに完全に
//   独立してTTCラッチを持つ（追跡中は毎フレーム再評価、ただしyield確定後はgoに
//   自動で戻さない安全側ラッチ）。rt_target_cpだけは追跡中の相手車ごとの値ではなく、
//   このindex(=交錯レーン)固有の固定値（M6b、03_UPDATE_LANE_ATTRIB.vflでlane_changed時に
//   Road Line側から確定済み）。08_STATEが読む
//   i@yield_conflict/f@dist_to_conflictは、全indexのうちyield中のものだけを見て
//   「最も近い交錯点」に集約する。


if (s@turn != "right") {
    // 右折区間を抜けた（またはそもそも右折でない）→ 状態を一律クリアしておく
    // （次に別の交差点で右折を始めたときにゼロから評価し直すため）
    i[]@rt_decided     = {};
    i[]@rt_target_id   = {};
    i[]@rt_target_lock = {};
    i[]@rt_clear_count = {};
    v[]@rt_target_cp   = {};
    f[]@dbg_ttc_margin = {};
    f[]@dbg_t_other    = {};
    f[]@dbg_t_ego      = {};
    f[]@dbg_ego_fwd    = {};
    f[]@dbg_dcp        = {};
    i@yield_conflict   = 0;
    f@dist_to_conflict = 9999.0;

// 以下の処理は、右折車のみに適用
} else {
    float search_radius = 40;   // 要チューニング
    float safety_margin = 4;               // s（t_other < t_ego + margin でblocking。M6。要チューニング）
    float v_floor        = 1;               // m/s
    float vel_stopped    = 0.1;               // m/s（これ未満は停止中とみなす。M6）
    float stop_margin    = 0.5;               // m（交錯点上に居座らないための最小距離。08のstop_offset=1より小さくすること）
    int   clear_frames   = 24;                // 脅威なしが何フレーム続いたらyieldを解除するか
    float ego_ahead_min  = 0.0;               // m（進行方向への射影がこれ未満なら交錯点を通過したとみなす）

    // 検知の候補となるポイントを検索
    int cands[] = nearpoints(0, @P, search_radius);   // indexループ全体で使い回す
    i[]@cands = cands;   // デバッグ用：検索半径内のptnum一覧

    // ローカル配列にコピー
    string lanes[]        = s[]@cross_lines;
    int    in_decided[]     = i[]@rt_decided;
    int    in_target_id[]   = i[]@rt_target_id;
    int    in_target_lock[] = i[]@rt_target_lock;
    int    in_clear_count[] = i[]@rt_clear_count;
    vector in_target_cp[]   = v[]@rt_target_cp;

    int    out_decided[]     = {};
    int    out_target_id[]   = {};
    int    out_target_lock[] = {};
    int    out_clear_count[] = {};
    vector out_target_cp[]   = {};
    // デバッグ用
    float  out_dbg_margin[]  = {};
    float  out_dbg_t_other[] = {};
    float  out_dbg_t_ego[]   = {};
    float  out_dbg_ego_fwd[] = {};
    float  out_dbg_dcp[]     = {};

    int   any_yield  = 0;
    float best_dist  = 9999.0;
    int   n_cross    = len(lanes); // 合計レーン数

    for (int idx = 0; idx < n_cross; idx++) {
        string opp_lane  = lanes[idx];
        int    t_id      = in_target_id[idx];
        int    t_lock    = in_target_lock[idx];
        int    t_clear   = in_clear_count[idx];
        vector t_cp      = in_target_cp[idx];
        int    t_decided = in_decided[idx];

        // ── 候補探索：このindexの相手レーン(opp_lane)を持ち、未通過・検索半径内の直進車 ──
        int   any_candidate         = 0;
        int   target_seen_this_frame = 0;
        int   target_pt              = -1;   // ★ 追跡中の相手(t_id)そのもののpt。毎フレームのTTC再評価に使う
        int   nearest_pt            = -1;
        float nearest_d             = 9999.0;
        // デバッグ用：TTCを評価しなかったindexは-9999のまま
        float dbg_margin  = -9999.0;   // t_ego + safety_margin - t_other（正ならblocking）
        float dbg_t_other = -9999.0;   // 相手が交錯点に着くまでの時間
        float dbg_t_ego   = -9999.0;   // 自分が交錯点に着くまでの時間
        float dbg_ego_fwd = -9999.0;   // 自分のdirと「自分→交錯点」の内積
        float dbg_dcp     = -9999.0;   // 自分から交錯点までの距離

        // 候補の直進車探し
        foreach (int pt; cands) {
            if (pt == @ptnum) continue; // 自分のポイント
            if (point(0, "car", pt) != 1) continue;    // 車以外の点
            // ★ cross_linesには曲線が実際に交差している1本のprimしか入らない。
            //   レーンは分割されているので、その手前のprimにいる後続車も拾わないと
            //   「もう対向車はいない」と誤判断してgoに倒れる。
            //   next_lane_nameはその車が選んだ行き先なので、別レーンへ逸れる車は
            //   一致せず除外される（むしろ正確）
            if (point(0, "lane_name",      pt) != opp_lane
             && point(0, "next_lane_name", pt) != opp_lane) continue;

            // このindexの交錯点(t_cp)を相手が既に通過していたら候補から外す。
            // i@passedは48フレームの確認待ちがある上に交錯点1つ分しか見ていないため、
            // ここではindex固有のt_cpとの前後関係を毎フレーム直接判定する
            vector opp_p   = point(0, "P",   pt);   // 型を明示して受ける（dotの多重定義回避）
            vector opp_dir = point(0, "dir", pt);
            vector to_cp   = t_cp - opp_p;
            float  len_cp  = length(to_cp);
            if (len_cp > 1e-4
                && dot(normalize(opp_dir), to_cp / len_cp) <= 0) continue;

            any_candidate = 1;
            if (point(0, "id", pt) == t_id) { target_seen_this_frame = 1; target_pt = pt; }

            float d = distance(point(0, "P", pt), @P);
            if (d < nearest_d) { nearest_d = d; nearest_pt = pt; }
        }

        // ロック中の相手が候補集合から消えた（通過 or 検索半径外）→ 解除して次点を拾えるようにする
        if (t_id >= 0 && !target_seen_this_frame) {
            t_id   = -1;
            t_lock = 0;
        }

        // 新しい相手を初めて捕捉
        if (t_id < 0 && nearest_pt >= 0) {
            t_id      = point(0, "id", nearest_pt);
            target_pt = nearest_pt;
        }

        // ★ 追跡中は毎フレームTTCを再評価する


        if (t_id >= 0 && target_pt >= 0) {
            // t_cpは03_UPDATE_LANE_ATTRIB.vflのlane_changed時にRoad Line側の
            // cross_pos(prim)から既に確定済み（M6b）。ここでは追跡中の相手車からは読まない。

            // 直進車の情報を取得
            float o_vel   = point(0, "vel", target_pt);
            float o_accel = point(0, "accel", target_pt);
            float o_dist  = distance(t_cp, point(0, "P", target_pt));

            // TTCは、加速度も考慮に入れる
            float t_other = time_to_reach(o_dist, o_vel, o_accel, v_floor);

            float e_dist = distance(t_cp, @P);
            float t_ego;
            if (i@car_state >= 1 && f@vel < vel_stopped) {
                // 停止中：現在0初速 → max_accelで発進したとみなした到達時間（等加速度式）
                t_ego = sqrt(2.0 * e_dist / max(f@max_accel, 0.01));
            } else {
                // 走行中：t_otherと同じ式を自車のP/vel/accelで解く
                t_ego = time_to_reach(e_dist, f@vel, f@accel, v_floor);
            }

            t_lock = (t_other < t_ego + safety_margin) ? 1 : 0;
            dbg_margin  = t_ego + safety_margin - t_other;
            dbg_t_other = t_other;
            dbg_t_ego   = t_ego;
        }

        int has_seen = (t_id >= 0);
        int blocked  = has_seen && (t_lock == 1);

        // ── 判断ラッチ（このindex単独） ──
        if (!any_candidate) {
            // 脅威が消えても即座には発進しない。clear_framesフレーム連続で
            // 候補なしを確認してから解除する（交錯点の境界でのフリッカー防止）
            t_clear += 1;
            if (t_clear >= clear_frames) t_decided = 0;         // 対象車がいない → none
        } else {
            t_clear = 0;
            if (t_decided == 0 && has_seen) {
                t_decided = blocked ? 1 : 2;                    // 初回確定 yield:1 / go:2
            } else if (t_decided == 2 && blocked) {
                t_decided = 1;                                  // 本当に新しく見えた相手がblockingなら即昇格
            }
            // yieldはここでは自動でgoに戻さない（安全側は自動で緩めない）
        }

        // ── 交錯点で居座らない：止まり切れず手前まで来てしまったら通過へ切替 ──
        // ★ t_id >= 0 は条件にしない。候補が消えた直後もt_decidedが1の間はyieldを
        //   維持しないと、clear_framesのデバウンスが素通りしてしまう。
        //   t_cpは相手車に依存しない固定値なので、相手がいなくても評価できる
        if (t_decided == 1) {
            vector to_cp = t_cp - @P;
            float  dCp   = length(to_cp);

            // ★ distance()は符号なしなので、交錯点を通過して離れるとまたdCpが大きくなり
            //   yieldに戻ってしまう。進行方向への符号付き射影で前後を判定する。
            //   ★ 正規化した内積は使わない：交錯点に近づくほど横方向のズレに敏感になり、
            //   車が曲線をショートカットして外へ膨らむ分だけで角度が跳ね上がって、
            //   通過していないのに通過扱いになっていた。射影なら横ズレの影響を受けない
            float ego_ahead = dot(normalize(v@dir), to_cp);   // m（正なら前方）
            dbg_ego_fwd = ego_ahead;
            dbg_dcp     = dCp;

            // ★ 「止まり切れないなら抜ける」の判定を距離の固定値ではなく物理で行う。
            //   旧実装はdCp < 3.0固定だったが、08_STATEは交錯点の1m手前で止まろうとする
            //   (stop_offset=1)ため、停止位置に着く前に必ず3mを切ってyieldが解除され、
            //   右折車が譲らずに突っ込んでいた。
            //   ★ 判定するのは巡航中(car_state==0)だけ。減速を始めた後は08が実行可能な
            //   required_decelを算出済みなので、07が判断し直すと
            //   「減速→止まれないと誤判定→go→加速→ますます止まれない」の片道ループに陥る
            float stop_dist  = (f@vel * f@vel) / (2.0 * max(f@max_decel, 0.01));
            int   cannot_stop = (i@car_state == 0) && (stop_dist > dCp);

            if (cannot_stop || dCp < stop_margin || ego_ahead < ego_ahead_min) {
                t_decided = 2;   // 止まり切れない or 交錯点上 or もう通過した → 抜ける
            } else {
                any_yield = 1;
                best_dist = min(best_dist, dCp);
            }
        }

        append(out_decided,     t_decided);
        append(out_target_id,   t_id);
        append(out_target_lock, t_lock);
        append(out_clear_count, t_clear);
        append(out_target_cp,   t_cp);
        append(out_dbg_margin,  dbg_margin);
        append(out_dbg_t_other, dbg_t_other);
        append(out_dbg_t_ego,   dbg_t_ego);
        append(out_dbg_ego_fwd, dbg_ego_fwd);
        append(out_dbg_dcp,     dbg_dcp);
    }

    i[]@rt_decided     = out_decided;
    i[]@rt_target_id   = out_target_id;
    i[]@rt_target_lock = out_target_lock;
    i[]@rt_clear_count = out_clear_count;
    v[]@rt_target_cp   = out_target_cp;

    f[]@dbg_ttc_margin = out_dbg_margin;
    f[]@dbg_t_other    = out_dbg_t_other;
    f[]@dbg_t_ego      = out_dbg_t_ego;
    f[]@dbg_ego_fwd    = out_dbg_ego_fwd;
    f[]@dbg_dcp        = out_dbg_dcp;

    // ── 集約：どれか1つでもyield中なら止まる。距離は一番近いものを使う ──
    i@yield_conflict   = any_yield;
    f@dist_to_conflict = any_yield ? best_dist : 9999.0;
}
