// ── IDM（前車追従）────────────────────────────────────
// CRUISINGはこれをそのまま使う。BRAKING中も停止用の減速と強い方を採るため、
// 状態分岐の外で毎フレーム計算しておく
float v0    = f@max_speed;
float T     = 1.5;
float s0    = 10;
float a     = f@max_accel;
float b     = f@max_decel;
float delta = 4.0;

// 交差車は静止障害物に近い。s0=8 だと手前で過剰に止まるので詰める
if (i@car_is_cross == 1) {
    s0 = 5.0;
    T  = 1.0;
}

float v_lead, s;
if (i@car_ptnum >= 0) {
    v_lead = f@car_vel;
    s      = max(f@dist_to_car, 0.1);
} else {
    v_lead = v0;
    s      = 9999.0;
}

float free_road_term   = pow(f@vel / max(v0, 0.01), delta);
float delta_v          = f@vel - v_lead;
float s_star           = s0 + f@vel * T + (f@vel * delta_v) / (2.0 * sqrt(a * b));
float interaction_term = pow(s_star / s, 2);
float a_idm            = a * (1.0 - free_road_term - interaction_term);

// 障害物が突然現れたときの発散防止
a_idm = max(a_idm, -b * 2.0);

// ── CRUISING ─────────────────────────────────────────
if (i@car_state == 0) {
    f@accel = a_idm;

    // ★ 譲り終えた直後だけ、交錯点を早く抜けるために加速を上乗せする。
    //   正の値にだけ掛ける（a自体を上げるとIDMのs_starも縮んで前車に詰めすぎる）
    float rt_boost_gain = 1.5;
    if (i@rt_boost > 0 && f@accel > 0) f@accel *= rt_boost_gain;

    if (@accel < 0)       i@col = 1;
    else if (@vel < 0.05) i@col = 2;

// ── BRAKING: 信号・歩行者 ────────────────────────────
} else if (i@car_state == 1) {
    if (f@effective_dist <= 1) {
        f@accel = -f@required_decel * 1.2;
    } else {
        f@accel = -f@required_decel;
    }
    // ★ 停止対象が前車より遠いと減速が緩く、前車が先に止まると追突する。
    //   停止対象用の減速とIDMの強い方を採る
    if (i@car_ptnum >= 0) f@accel = min(f@accel, a_idm);

    if (f@vel < 0.1) {
        f@accel     = 0.0;
        f@vel       = 0.0;
        i@car_state = 2;
    }

// ── STOPPED ──────────────────────────────────────────
} else if (i@car_state == 2) {
    f@accel = 0.0;
    f@vel   = 0.0;
}
