// ════════════════════════════════════════════════════
// DEBUG_CROSS_MATCH: Solverの外側（Solverノードの直後）に置くデバッグ専用ノード。
// 右折車のcross_linesに対応する直進車が、実際に見つかっているかをSpreadsheetで
// 直接確認できるようにする。シミュレーション本体のロジックには一切影響しない。
//
// Input 0: 車両（Solverの出力）
// 書く（すべてdbg_接頭辞、右折車のみ意味を持つ）:
//   s@dbg_cross_lines_joined … cross_linesの中身をカンマ区切りで1本のstringにしたもの
//   i@dbg_any_same_lane_car  … search_radius無視で、シーン中にcross_linesと同じ
//                              lane_nameを持つ車が1台でも存在するか
//   f@dbg_nearest_dist       … そのうち最も近い車までの距離（search_radius無視）
//   i@dbg_nearest_passed     … その最寄り車のi@passed
//   s@dbg_nearest_lane_name  … その最寄り車の実際のlane_name（cross_linesの値と
//                              見比べて完全一致しているか目視確認する）
//   i@dbg_in_radius          … その最寄り車が07_RESOLVE_CONFLICTのsearch_radius(36)
//                              以内に入っているか
//   i@dbg_nearest_pt         … その最寄り車のptnum（Spreadsheetやビューポートで
//                              実際にその車を選択・特定するため）
// ════════════════════════════════════════════════════
s@dbg_cross_lines_joined = "";
i@dbg_any_same_lane_car  = 0;
f@dbg_nearest_dist       = -1.0;
i@dbg_nearest_passed     = -1;
s@dbg_nearest_lane_name  = "";
i@dbg_in_radius          = 0;
i@dbg_nearest_pt         = -1;

if (s@turn != "right") return;

float search_radius = 36;   // 07_RESOLVE_CONFLICT.vflと同じ値に揃えること

string lanes[] = s[]@cross_lines;

// cross_lines自体が空かどうかがまず一番わかりやすい指標
string joined = "";
foreach (string ln; lanes) {
    joined += (joined == "" ? "" : ",") + ln;
}
s@dbg_cross_lines_joined = (len(lanes) == 0) ? "(EMPTY)" : joined;

if (len(lanes) == 0) return;

// ★ search_radiusを無視して全点を総当たりする（半径が問題なのか、
//   そもそもlane_nameが一致していないのかを切り分けるため）
int n = npoints(0);
float best_d = 1e9;
int   best_pt = -1;

for (int pt = 0; pt < n; pt++) {
    if (pt == @ptnum) continue;
    if (point(0, "car", pt) != 1) continue;
    string other_lane = point(0, "lane_name", pt);
    if (find(lanes, other_lane) < 0) continue;

    float d = distance(point(0, "P", pt), @P);
    if (d < best_d) {
        best_d  = d;
        best_pt = pt;
    }
}

if (best_pt >= 0) {
    i@dbg_any_same_lane_car = 1;
    f@dbg_nearest_dist      = best_d;
    i@dbg_nearest_passed    = point(0, "passed", best_pt);
    s@dbg_nearest_lane_name = point(0, "lane_name", best_pt);
    i@dbg_in_radius         = (best_d <= search_radius) ? 1 : 0;
    i@dbg_nearest_pt        = best_pt;
}
