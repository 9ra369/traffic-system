// 切り替え直後: 新しい lane_name から lane_id を再解決
// lane_nameは、末端でnext_lane_nameから値を引き継いでいる
if (i@lane_changed == 1) {
    int pt = nearpoint(1, "@lane_name=" + s@lane_name, @P);
    if (pt >= 0) {
        i@lane_id = point(1, "lane_id", pt);

        //lane_idを取得
        int lane_pt = findattribval(1, "point", "lane_id", i@lane_id);
        // ここで、このレーンの持つ、次のレーンの候補を取得し、次のレーンを決定
        if (lane_pt >= 0) {
            // 次に進むべきレーンを決定
            string nexts[] = point(1, "next_lanes", lane_pt);
            int n = len(nexts);
            // 選んだindexは下の先読みでnext_turnsを引くのにも使う
            int next_idx = -1;
            if (n == 1) {
                next_idx = 0;
            //次のLaneが複数ある時
            } else if (n > 1) {
                next_idx = min(int(rand(@id + i@lane_id) * n), n - 1);  // 車×道路でseed
            }
            s@next_lane_name = (next_idx >= 0) ? nexts[next_idx] : "";   // 候補なし(行き止まり等)は空

            // 新しいレーンの交錯点情報を作り直す（直進車のみ使う）
            i@passed             = 0;
            i@passed_frame_count = 0;
            v@cross_pos          = {0, 0, 0};

            // 今まさに乗っているprim
            int pr[] = pointprims(1, pt);
            string cross_lines_local[]     = {};
            string cross_curves_local[]    = {};
            vector cross_line_pos_local[]  = {};
            vector cross_curve_pos_local[] = {};
            i@rt_lookahead = 0;
            s@next_turn    = "";
            i@nt_baked     = -1;   // -1=判定せず 0=next_turnsの本数不一致 1=一致（11の焼き漏れ検出）
            i@dbg_conn     = -1;   // デバッグ用：右折の先読みで引いたコネクタprim（-1=引けず）
            if (len(pr) > 0) {
                int prim0 = pr[0];

                // 交錯点情報を取得
                vector cp_candidates[] = prim(1, "cross_pos", prim0);
                if (len(cp_candidates) > 0) {
                    v@cross_pos = cp_candidates[0];
                }

                // 交錯ライン/右折カーブ情報を取得
                cross_lines_local  = prim(1, "cross_lines",  prim0);
                cross_curves_local = prim(1, "cross_curves", prim0);
                // 相手(直進)レーン側の交錯点座標。cross_linesと同indexで
                cross_line_pos_local = prim(1, "cross_line_pos", prim0);
                // 自分(直進レーン)側の交錯点座標。cross_curvesと同indexで
                cross_curve_pos_local = prim(1, "cross_curve_pos", prim0);

                // ── 右折の先読み ──────────────────────────────
                if (next_idx >= 0) {
                    // next_turnsは11がnext_lanesと同indexで焼いている（左折・直進も07/06の候補除外で使う）
                    string nturns[] = prim(1, "next_turns", prim0);
                    i@nt_baked  = (len(nturns) == n);   // 本数が合わなければ11の焼き直し漏れ
                    if (i@nt_baked) s@next_turn = nturns[next_idx];

                    if (s@next_turn == "right") {
                        // ★ 交錯情報はコネクタprimにしか無いので、右折のときだけprimを引く。
                        //   next_laneは行き先レーン名で別の入口から来たコネクタにも一致するため、
                        //   入口を特定できるprev_lane（入口のlane_id）で絞る
                        int conn = -1;
                        int n_conn = findattribvalcount(1, "prim", "prev_lane", i@lane_id);
                        for (int k = 0; k < n_conn; k++) {
                            int c = findattribval(1, "prim", "prev_lane", i@lane_id, k);
                            if (c < 0 || prim(1, "is_connector", c) != 1) continue;   // 既定値0のprimを弾く
                            if (prim(1, "next_lane", c) == s@next_lane_name) { conn = c; break; }
                        }
                        i@dbg_conn = conn;
                        if (conn >= 0) {
                            cross_lines_local    = prim(1, "cross_lines",    conn);
                            cross_line_pos_local = prim(1, "cross_line_pos", conn);
                            i@rt_lookahead       = 1;
                        }
                    }
                }
            }
            // ★ ベイク漏れを黙って通さない。cross_linesがあるのにcross_line_posが無い/
            //   本数が合わないなら13_BAKE_CROSS_LINESの焼き直し漏れ（属性が無いと
            //   prim()は空配列を返すだけでエラーは出ない）
            i@cp_baked = (len(cross_lines_local) == 0)
                       ? -1                                                    // 交錯情報を持たないレーン＝判定対象外
                       : (len(cross_line_pos_local) == len(cross_lines_local));

            string prev_lines[] = s[]@cross_lines;   // 上書き前に退避（ラッチ引き継ぎ判定用）
            s[]@cross_lines     = cross_lines_local;
            s[]@cross_curves    = cross_curves_local;
            v[]@cross_curve_pos = cross_curve_pos_local;

            // cross_linesと同indexの判断ラッチ配列。先読みで既に同じ交錯レーン一式を
            // 持っているなら引き継ぐ。積み直すとコネクタに乗った瞬間に判断が0に戻り、
            // 交差点の中で譲り直しになってしまう
            int n_cross = len(cross_lines_local); // 交錯する数
            int same_cross = (len(prev_lines) == n_cross);
            for (int k = 0; same_cross && k < n_cross; k++) {
                if (prev_lines[k] != cross_lines_local[k]) same_cross = 0;
            }
            if (!(same_cross && n_cross > 0)) {
                int new_decided[]     = {};
                int new_target_id[]   = {};
                int new_target_lock[] = {};
                int new_clear_count[] = {};
                for (int cross_idx = 0; cross_idx < n_cross; cross_idx++) {
                    append(new_decided,     0);
                    append(new_target_id,   -1);
                    append(new_target_lock, 0);
                    append(new_clear_count, 0);
                }
                i[]@rt_decided     = new_decided;
                i[]@rt_target_id   = new_target_id;
                i[]@rt_target_lock = new_target_lock;
                i[]@rt_clear_count = new_clear_count;
                // ★ t_cpもラッチを積み直すときだけ入れ替える。同じ交錯レーンなら
                //   同じ交錯点のはずで、毎回代入すると先読み中に使っていた値が
                //   コネクタに乗った瞬間に別のprim由来の値へ黙って飛ぶことがある
                //   （ego_aheadが急に負へ跳ねてgo_reason=3で譲りが外れる）
                v[]@rt_target_cp   = cross_line_pos_local;
            }

            // ★ フラグを下ろすのはここまで来られたときだけ。lane_pt解決前に下ろすと、
            //   passed/cross_pos/cross_linesが前のレーンの値のまま残り、次フレームの
            //   再試行も走らない（___SPEC.mdのリトライパターン）
            i@lane_changed = 0;
        }
    }
}

// 毎フレーム: 今のレーン(lane_id)上の最寄り点から dir/curv/turn を読み直す。
int pt = nearpoint(1, "@lane_id=" + itoa(i@lane_id), @P);
if (pt >= 0) {
    v@dir  = point(1, "dir",  pt);
    f@curv = point(1, "curv", pt);
    s@turn = point(1, "turn", pt); 
}
